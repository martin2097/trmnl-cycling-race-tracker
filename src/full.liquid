{%- assign tag = stage_tag | default: 'NEXT STAGE' -%}
{%- assign wtag = winner_tag | default: 'LAST STAGE WINNER' -%}
{%- assign rank_when = ranking_tag | default: wtag | remove: ' WINNER' -%}
{%- if pre_race -%}
  {%- comment -%}
    
    
===================== PRE-RACE OVERVIEW =====================

  
  {% endcomment %}
  {%- assign dist_num = ov_distance | remove: ' km' -%}
  <div class="layout layout--col gap--none h--full">
    <div class="grid grid--cols-12 gap--large grow w--full">
      {%- comment -%}
        
        
---- LEFT: centered countdown panel, dark-gray (col 4/12) ----

      
      {% endcomment %}
      <div class="col--span-4 lg:col--span-5 lg:portrait:col--span-12 h--full">
        <div class="bg--gray-20 rounded--large h--full w--full flex flex--col flex--center-x flex--center-y gap--medium p--6 overflow--hidden">
          <span class="title title--large lg:title--xlarge lg:portrait:title--xlarge text--white text--center">
            {{ pre_headline }}
          </span>
          {% if race_day_waiting %}
            <span class="title lg:title--large lg:portrait:title--large text--white text--center">IT'S RACE DAY TODAY!</span>
            {% else %}
            <span class="value value--mega lg:value--giga lg:portrait:value--giga value--tnums text--white">
              {{ days_to_start }}
            </span>
            <span class="title lg:title--large lg:portrait:title--large text--white text--center">DAYS TO GO</span>
          {% endif %}
        </div>
      </div>
      {%- comment -%}
        
        
---- RIGHT: 3 sections, flush top/bottom, even gaps between (col 8/12) ----

      
      {% endcomment %}
      <div class="col--span-8 lg:col--span-7 lg:portrait:col--span-12 flex flex--col h--full overflow--hidden">
        {%- comment -%}
          
          
overview (flush to top)

        
        {% endcomment %}
        <div class="flex flex--col w--full no-shrink pt--4">
          <div class="flex flex--row gap--medium w--full flex--center-y">
            <div class="grow overflow--hidden">
              {% render 'stat_cell' with icon: cal_glyph, value: ov_date, unit: '' %}
            </div>
            <div class="grow overflow--hidden">
              {% render 'stat_cell' with icon: flag_glyph, value: ov_stages, unit: 'STAGES' %}
            </div>
            <div class="grow overflow--hidden">
              {% render 'stat_cell' with icon: road_glyph, value: dist_num, unit: 'KM' %}
            </div>
          </div>
        </div>
        {%- comment -%}
          
          
jersey holders

        
        {% endcomment %}
        <div class="divider mt--2 mb--2"></div>
        <span class="title title--small lg:title--base">LAST YEAR JERSEY WINNERS</span>
        <div class="flex flex--col w--full no-shrink">
          {%- comment -%}
            
            
X LANDSCAPE: 2x2 (lg:grid--cols-2); OG keeps 1x4 (grid--cols-4) 

          
          {% endcomment %}
          {%- comment -%}
            
            
OG 1x4 · X landscape 2x2 · X portrait 1x4 (all in line) 

          
          {% endcomment %}
          <div class="grid grid--cols-4 lg:grid--cols-2 lg:portrait:grid--cols-4 gap--medium w--full">
            <div class="overflow--hidden">
              {% render 'jersey_card' with jersey: jersey_gc, label: 'INDIVIDUAL', name: yellow_name, team: yellow_team_code, photo: yellow_photo, alt: yellow_photo_alt, fallback: person_glyph %}
            </div>
            <div class="overflow--hidden">
              {% render 'jersey_card' with jersey: jersey_pts, label: 'POINTS', name: green_name, team: green_team_code, photo: green_photo, alt: green_photo_alt, fallback: person_glyph %}
            </div>
            <div class="overflow--hidden">
              {% render 'jersey_card' with jersey: jersey_kom, label: 'CLIMBER', name: kom_name, team: kom_team_code, photo: kom_photo, alt: kom_photo_alt, fallback: person_glyph %}
            </div>
            <div class="overflow--hidden">
              {% render 'jersey_card' with jersey: jersey_yth, label: 'YOUNG', name: white_name, team: white_team_code, photo: white_photo, alt: white_photo_alt, fallback: person_glyph %}
            </div>
          </div>
        </div>
        {%- comment -%}
          
          
stage 1 (flush to bottom): rule + text (left) + profile (right)

        
        {% endcomment %}
        <div class="divider mt--2 mb--2"></div>
        <div class="flex flex--col w--full no-shrink">
          <span class="title title--small lg:title--base lg:pb--2">STARTING OF WITH ...</span>
          {%- comment -%}
            
            
X: profile drops to its own full-width line (lg:col--span-12); OG keeps text|profile side by side 

          
          {% endcomment %}
          <div class="grid grid--cols-12 gap--medium w--full">
            <div class="col--span-6 flex flex--col flex--center-y gap--xsmall overflow--hidden">
              <div class="flex flex--row flex--left flex--center-y gap--small no-shrink">
                {% render 'badge' with text: 'STAGE 1' %}
                <span class="label label--gray 1bit:text--black">
                  {{ next_date | upcase }}
                </span>
              </div>
              <span class="title title--small" data-clamp="2">
                {{ next_start | upcase }}
                
                
›

                
                {{ next_finish | upcase }}
              </span>
              <div class="flex flex--row flex--left flex--center-y gap--xsmall flex--wrap">
                {%- if next_type and next_type != '' -%}
                  <span class="label label--xsmall label--outline">
                    {{ next_type | upcase }}
                  </span>
                {% endif %}
                {%- if next_km and next_km != '' -%}
                  <span class="label label--gray value--tnums 1bit:text--black">
                    {{ next_km }}
                  </span>
                {% endif %}
                {%- if next_gain and next_gain != 0 -%}
                  <span class="flex flex--row flex--center-y gap--xsmall">
                    <img class="image w--[12px] h--[10px] no-shrink" src="data:image/svg+xml;base64,{{ peak_glyph | base64_encode }}">
                    <span class="label label--gray value--tnums 1bit:text--black">
                      {{ next_gain }}
                      
                      
m

                    
                    </span>
                  </span>
                {% endif %}
              </div>
            </div>
            <div class="col--span-6 flex flex--center-y flex--center-x overflow--hidden">
              {%- comment -%}
                
                
small profile: OG + X portrait (text|profile side by side); hidden on X landscape 

              
              {% endcomment %}
              <div class="flex lg:hidden flex--center-y flex--center-x">
                {% render 'stage_profile' with path: profile_path, climbs: profile_climbs, fixedw: 205, h: 78, circ: 4.5, cfont: 4.2, km: next_km %}
              </div>
              {%- comment -%}
                
                
big profile: X LANDSCAPE only — fills its own full-width line (~double height + width) 

              
              {% endcomment %}
              <div class="hidden lg:flex flex--center-x">
                {% render 'stage_profile' with path: profile_path, climbs: profile_climbs, fixedw: 263, h: 100, circ: 4.5, cfont: 4.2, km: next_km %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {%- else -%}
  {%- comment -%}
    
    
===================== RACING / RACE-OVER =====================

  
  {% endcomment %}
  <div class="layout layout--col gap--none h--full px--3 py--2">
    {%- comment -%}
      
      
---- TOP: full-width stage banner (text left + fixed-proportion profile right) ----

    
    {% endcomment %}
    {%- if race_over -%}
      {%- assign gc0 = gc[0] | split: '|||' -%}
      <div class="flex flex--row flex--center-y gap--large w--full no-shrink overflow--hidden">
        <div class="flex flex--row flex--left flex--center-y gap--medium grow overflow--hidden">
          {% render 'avatar' with url: yellow_photo, size: 92, fallback: person_glyph, alt: yellow_photo_alt %}
          <div class="flex flex--col flex--left gap--xsmall grow overflow--hidden">
            <div class="flex flex--row flex--left no-shrink">
              <span class="bg--black text--white rounded--small px--2 label lg:label--large lg:portrait:label--base no-shrink">
                {{ winner_label }}
              </span>
            </div>
            <span class="title lg:title--xlarge">
              {{ yellow_name }}
            </span>
            <span class="label label--gray 1bit:text--black">
              {{ yellow_team_code }}
            </span>
          </div>
        </div>
        <div class="flex flex--row flex--center-y gap--large no-shrink">
          <div class="flex flex--col flex--center-x flex--center-y gap--xsmall overflow--hidden">
            <img class="image w--[26px] h--[26px] no-shrink" src="data:image/svg+xml;base64,{{ flag_glyph | base64_encode }}">
            <span class="label label--small label--gray text--center 1bit:text--black">TOTAL TIME</span>
            <span class="value value--xsmall value--tnums text--center">
              {{ gc0[3] }}
            </span>
          </div>
          <div class="w--[1px] h--[68px] bg--gray-55 no-shrink"></div>
          <div class="flex flex--col flex--center-x flex--center-y gap--xsmall overflow--hidden">
            <img class="image w--[26px] h--[26px] no-shrink" src="data:image/svg+xml;base64,{{ road_glyph | base64_encode }}">
            <span class="label label--small label--gray text--center 1bit:text--black">TOTAL DISTANCE</span>
            <span class="value value--xsmall value--tnums text--center">
              {{ ov_distance }}
              
              
km

            
            </span>
          </div>
          <div class="w--[1px] h--[68px] bg--gray-55 no-shrink"></div>
          <div class="flex flex--col flex--center-x flex--center-y gap--xsmall overflow--hidden">
            <img class="image w--[30px] h--[25px] no-shrink" src="data:image/svg+xml;base64,{{ peak_glyph | base64_encode }}">
            <span class="label label--small label--gray text--center 1bit:text--black">TOTAL ELEVATION</span>
            <span class="value value--xsmall value--tnums text--center">
              {{ total_climb }}
              
              
m

            
            </span>
          </div>
        </div>
      </div>
      {%- elsif rest_day -%}
      {%- comment -%}
        
        
---- REST DAY: "sleeping" graphic, sized/gated like the stage profile ---- 

      
      {% endcomment %}
      <div class="flex flex--row flex--center-y gap--large w--full no-shrink overflow--hidden">
        <div class="flex flex--col flex--left gap--medium grow overflow--hidden">
          <div class="flex flex--row flex--left flex--center-y gap--medium no-shrink">
            {% render 'badge' with text: 'REST DAY' %}
            {%- if rest_when and rest_when != '' -%}
              <span class="label label--xsmall lg:label--large">
                {{ rest_when }}
              </span>
            {% endif %}
          </div>
          <span class="title title--medium lg:title--large">LEGS UP, WHEELS DOWN</span>
          <div class="flex flex--row flex--left flex--center-y gap--small flex--wrap">
            <span class="label label--base lg:label--large">NEXT UP</span>
            <span class="label label--base lg:label--large value--tnums">
              
              
STAGE 

              
              {{ next_stage_no }}
            </span>
            <span class="label label--base lg:label--large">
              {{ next_start | upcase }}
              
              
› 

              
              {{ next_finish | upcase }}
            </span>
          </div>
        </div>
        <div class="flex flex--center-y flex--center-x no-shrink lg:hidden">
          {% render 'rest_graphic' with fixedw: 279, h: 106 %}
        </div>
        <div class="hidden lg:visible lg:portrait:hidden">
          <div class="flex flex--center-y flex--center-x no-shrink">
            {% render 'rest_graphic' with fixedw: 419, h: 159 %}
          </div>
        </div>
      </div>
      {%- comment -%}
        
        
X PORTRAIT: sleeping graphic stacked under the text — wide-flat banner (2x width, half height) for a natural fit 

      
      {% endcomment %}
      <div class="hidden lg:portrait:block w--full no-shrink mt--8 mb--2">
        <div class="w--full">
          {% render 'rest_banner' %}
        </div>
      </div>
      {%- else -%}
      <div class="flex flex--row flex--center-y gap--large w--full no-shrink overflow--hidden">
        <div class="flex flex--col flex--left gap--medium grow overflow--hidden">
          <div class="flex flex--row flex--left flex--center-y gap--medium no-shrink">
            {% render 'badge' with text: tag %}
            <span class="label lg:label--large">
              
              
STAGE

              
              {{ next_stage_no }}
              
              
·

              
              {{ next_date | upcase }}
              {{ race_year }}
            </span>
          </div>
          <span class="title title--medium lg:title--large" data-clamp="2">
            {{ next_start | upcase }}
            <span class="px--2">›</span>
            {{ next_finish | upcase }}
          </span>
          <div class="flex flex--row flex--left flex--center-y gap--medium lg:gap--large flex--wrap lg:portrait:hidden">
            {%- if next_type and next_type != '' -%}
              <span class="label lg:label--large label--outline">
                {{ next_type | upcase }}
              </span>
            {% endif %}
            {%- if next_km and next_km != '' -%}
              <span class="label lg:label--large label--gray value--tnums 1bit:text--black">
                {{ next_km }}
              </span>
            {% endif %}
            {%- if next_gain and next_gain != 0 -%}
              <span class="flex flex--row flex--center-y gap--xsmall">
                <img class="image w--[18px] h--[15px] no-shrink" src="data:image/svg+xml;base64,{{ peak_glyph | base64_encode }}">
                <span class="label lg:label--large label--gray value--tnums 1bit:text--black">
                  {{ next_gain }}
                  
                  
m

                
                </span>
              </span>
            {% endif %}
          </div>
        </div>
        <div class="flex flex--center-y flex--center-x no-shrink lg:hidden">
          {% render 'stage_profile' with path: profile_path, climbs: profile_climbs, fixedw: 279, h: 106, km: next_km %}
        </div>
        <div class="hidden lg:visible lg:portrait:hidden mr--4">
          <div class="flex flex--center-y flex--center-x no-shrink">
            {% render 'stage_profile' with path: profile_path, climbs: profile_climbs, fixedw: 326, h: 124, edgepad: 5, km: next_km %}
          </div>
        </div>
      </div>
      {%- comment -%}
        
        
X PORTRAIT: profile stacked UNDER the stage text

      
      {% endcomment %}
      <div class="hidden lg:portrait:flex flex--row flex--center-y gap--large w--full no-shrink mt--2">
        <div class="flex flex--col flex--center-x flex--center-y gap--medium grow overflow--hidden">
          {%- if next_type and next_type != '' -%}
            <span class="label label--xlarge label--outline">
              {{ next_type | upcase }}
            </span>
          {% endif %}
          {%- if next_km and next_km != '' -%}
            <span class="label label--xlarge label--gray value--tnums">
              {{ next_km }}
            </span>
          {% endif %}
          {%- if next_gain and next_gain != 0 -%}
            <span class="flex flex--row flex--center-y gap--xsmall">
              <img class="image w--[18px] h--[15px] no-shrink" src="data:image/svg+xml;base64,{{ peak_glyph | base64_encode }}">
              <span class="label label--xlarge label--gray value--tnums">
                {{ next_gain }}
                
                
m

              
              </span>
            </span>
          {% endif %}
        </div>
        <div class="flex flex--center-y no-shrink">
          {% render 'stage_profile' with path: profile_path, climbs: profile_climbs, fixedw: 419, h: 159, km: next_km %}
        </div>
      </div>
    {% endif %}
    <div class="divider mt--2 mb--2"></div>
    {%- comment -%}
      
      
---- BOTTOM: GC top 5 (left) + last winner &amp; jersey leaders (right) ----

    
    {% endcomment %}
    <div class="grid grid--cols-12 gap--large grow w--full">
      {%- comment -%}
        
        
---- left (6/12): last winner (row 1) + jersey leaders. Same table--base
+ sizes as the GC table on the right, so all 5 rows line up across the divider ----

      
      {% endcomment %}
      <div class="col--span-6 overflow--hidden">
        {%- comment -%}
          
          
---- OG (md): winner + jersey rows in one table (unchanged), hidden on X ----

        
        {% endcomment %}
        <div class="flex flex--col flex--left gap--medium overflow--hidden lg:hidden w--full">
          <table class="table table--base w--full">
            <colgroup>
              <col class="w--[26px]">
              <col class="w--[92px]">
              <col>
            </colgroup>
            <tbody>
              <tr>
                <td class="pb--4" colspan="3">
                  <div class="flex flex--row flex--left flex--center-y gap--small overflow--hidden">
                    <div class="flex flex--center w--[80px] no-shrink lg:hidden">
                      {% render 'avatar' with url: winner_photo, size: 70, fallback: person_glyph, alt: winner_photo_alt %}
                    </div>
                    <div class="hidden lg:visible">
                      <div class="flex flex--center w--[110px] no-shrink">
                        {% render 'avatar' with url: winner_photo, size: 100, fallback: person_glyph, alt: winner_photo_alt %}
                      </div>
                    </div>
                    <div class="flex flex--col flex--left gap--small overflow--hidden">
                      <div class="flex flex--row flex--left w--full">
                        {% render 'badge' with text: wtag %}
                      </div>
                      <span class="title lg:title--xlarge">
                        {{ winner_name | default: '—' }}
                      </span>
                      <span class="label lg:label--large label--gray 1bit:text--black">
                        {{ winner_team_code }}
                      </span>
                    </div>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <img class="image w--[24px] h--[24px] no-shrink" src="data:image/svg+xml;base64,{{ jersey_gc | base64_encode }}">
                </td>
                <td>
                  <span class="label label--xsmall label--gray 1bit:text--black">INDIVIDUAL</span>
                </td>
                <td>
                  <div class="flex flex--row flex--left flex--center-y gap--small overflow--hidden">
                    <div class="flex flex--center w--[44px] no-shrink">
                      {% render 'avatar' with url: yellow_photo, size: 38, fallback: person_glyph, alt: yellow_photo_alt %}
                    </div>
                    <div class="flex flex--col flex--left gap--none overflow--hidden">
                      <span class="title title--small">
                        {{ yellow_name | default: '—' }}
                      </span>
                      <span class="label label--xsmall label--gray 1bit:text--black">
                        {{ yellow_team_code }}
                      </span>
                    </div>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <img class="image w--[24px] h--[24px] no-shrink" src="data:image/svg+xml;base64,{{ jersey_pts | base64_encode }}">
                </td>
                <td>
                  <span class="label label--xsmall label--gray 1bit:text--black">POINTS</span>
                </td>
                <td>
                  <div class="flex flex--row flex--left flex--center-y gap--small overflow--hidden">
                    <div class="flex flex--center w--[44px] no-shrink">
                      {% render 'avatar' with url: green_photo, size: 38, fallback: person_glyph, alt: green_photo_alt %}
                    </div>
                    <div class="flex flex--col flex--left gap--none overflow--hidden">
                      <span class="title title--small">
                        {{ green_name | default: '—' }}
                      </span>
                      <span class="label label--xsmall label--gray 1bit:text--black">
                        {{ green_team_code }}
                      </span>
                    </div>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <img class="image w--[24px] h--[24px] no-shrink" src="data:image/svg+xml;base64,{{ jersey_kom | base64_encode }}">
                </td>
                <td>
                  <span class="label label--xsmall label--gray 1bit:text--black">CLIMBER</span>
                </td>
                <td>
                  <div class="flex flex--row flex--left flex--center-y gap--small overflow--hidden">
                    <div class="flex flex--center w--[44px] no-shrink">
                      {% render 'avatar' with url: kom_photo, size: 38, fallback: person_glyph, alt: kom_photo_alt %}
                    </div>
                    <div class="flex flex--col flex--left gap--none overflow--hidden">
                      <span class="title title--small">
                        {{ kom_name | default: '—' }}
                      </span>
                      <span class="label label--xsmall label--gray 1bit:text--black">
                        {{ kom_team_code }}
                      </span>
                    </div>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <img class="image w--[24px] h--[24px] no-shrink" src="data:image/svg+xml;base64,{{ jersey_yth | base64_encode }}">
                </td>
                <td>
                  <span class="label label--xsmall label--gray 1bit:text--black">YOUNG</span>
                </td>
                <td>
                  <div class="flex flex--row flex--left flex--center-y gap--small overflow--hidden">
                    <div class="flex flex--center w--[44px] no-shrink">
                      {% render 'avatar' with url: white_photo, size: 38, fallback: person_glyph, alt: white_photo_alt %}
                    </div>
                    <div class="flex flex--col flex--left gap--none overflow--hidden">
                      <span class="title title--small">
                        {{ white_name | default: '—' }}
                      </span>
                      <span class="label label--xsmall label--gray 1bit:text--black">
                        {{ white_team_code }}
                      </span>
                    </div>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        {%- comment -%}
          
          
---- X (lg): winner (kept as-is) + jersey holders as 2x2 grid ----

        
        {% endcomment %}
        <div class="hidden lg:flex flex--col flex--left gap--medium overflow--hidden">
          <div class="flex flex--row flex--left flex--center-y gap--small overflow--hidden lg:portrait:hidden">
            <div class="flex flex--center w--[110px] no-shrink">
              {% render 'avatar' with url: winner_photo, size: 100, fallback: person_glyph, alt: winner_photo_alt %}
            </div>
            <div class="flex flex--col flex--left gap--small overflow--hidden">
              <div class="flex flex--row flex--left w--full">
                {% render 'badge' with text: wtag %}
              </div>
              <span class="title title--xlarge">
                {{ winner_name | default: '—' }}
              </span>
              <span class="label label--large label--gray">
                {{ winner_team_code }}
              </span>
            </div>
          </div>
          <div class="divider mt--1 mb--1 lg:portrait:hidden"></div>
          <div class="flex flex--col gap--none w--full grow lg:portrait:hidden">
            <div class="flex flex--row w--full grow">
              <div class="grow overflow--hidden">
                {% render 'jersey_panel' with jersey: jersey_gc, label: 'INDIVIDUAL', name: yellow_name, team: yellow_team_code, photo: yellow_photo, alt: yellow_photo_alt, fallback: person_glyph %}
              </div>
              <div class="w--[1px] bg--gray-70 h--full no-shrink mx--3"></div>
              <div class="grow overflow--hidden">
                {% render 'jersey_panel' with jersey: jersey_pts, label: 'POINTS', name: green_name, team: green_team_code, photo: green_photo, alt: green_photo_alt, fallback: person_glyph %}
              </div>
            </div>
            <div class="divider mt--2 mb--2"></div>
            <div class="flex flex--row w--full grow">
              <div class="grow overflow--hidden">
                {% render 'jersey_panel' with jersey: jersey_kom, label: 'CLIMBER', name: kom_name, team: kom_team_code, photo: kom_photo, alt: kom_photo_alt, fallback: person_glyph %}
              </div>
              <div class="w--[1px] bg--gray-70 h--full no-shrink mx--3"></div>
              <div class="grow overflow--hidden">
                {% render 'jersey_panel' with jersey: jersey_yth, label: 'YOUNG', name: white_name, team: white_team_code, photo: white_photo, alt: white_photo_alt, fallback: person_glyph %}
              </div>
            </div>
          </div>
          {%- comment -%}
            
            
X PORTRAIT: 4 jersey tiles stacked vertically (keep tiles, not a table)

          
          {% endcomment %}
          <div class="hidden lg:portrait:flex flex--left flex--col gap--none w--full grow">
            <div class="grow overflow--hidden">
              {% render 'jersey_panel_portrait' with jersey: trophy_glyph, label: 'STAGE WINNER', name: winner_name, team: winner_team_code, photo: winner_photo, alt: winner_photo_alt, fallback: person_glyph %}
            </div>
