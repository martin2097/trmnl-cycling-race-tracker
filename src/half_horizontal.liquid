{%- comment -%}
  
  
HALF HORIZONTAL (800x240). PRE-RACE: countdown panel + 3 stats on the LEFT,
last-year jersey winners on the RIGHT. RACING/REST/OVER: next-stage text + stage winner on
the LEFT, jersey holders on the RIGHT.


{% endcomment %}
{%- assign tag = stage_tag | default: 'NEXT STAGE' -%}
{%- assign wtag = winner_tag | default: 'LAST STAGE WINNER' -%}
{%- assign rank_when = ranking_tag | default: wtag | remove: ' WINNER' -%}
{%- if pre_race -%}
  {%- assign dist_num = ov_distance | remove: ' km' -%}
  <div class="layout layout--col gap--none h--full px--3 py--2 lg:portrait:hidden">
    <div class="grid grid--cols-12 gap--large grow w--full overflow--hidden">
      {%- comment -%}
        
        
LEFT: event-specific pre-race countdown filling the quarter + 3 stats

      
      {% endcomment %}
      <div class="col--span-6 flex flex--col gap--small overflow--hidden h--full">
        <div class="bg--gray-20 rounded--large grow w--full flex flex--col flex--center-x flex--center-y gap--xsmall p--2 overflow--hidden">
          <span class="title title--small text--white text--center">
            {{ pre_headline }}
          </span>
          {% if race_day_waiting %}
            <span class="label label--xsmall text--white text--center">IT'S RACE DAY TODAY!</span>
            {% else %}
            <span class="value value--tnums text--white">
              {{ days_to_start }}
            </span>
            <span class="label label--xsmall text--white text--center">DAYS TO GO</span>
          {% endif %}
        </div>
        {%- comment -%}
          
          
X landscape: facts share the column with the countdown (lg:grow) so the countdown shrinks a bit 

        
        {% endcomment %}
        <div class="flex flex--row gap--medium w--full flex--center-y no-shrink lg:grow">
          <div class="grow overflow--hidden">
            {% render 'stat_cell' with icon: cal_glyph, value: ov_date, unit: '' %}
          </div>
          <div class="grow overflow--hidden">
            {% render 'stat_cell' with icon: flag_glyph, value: ov_stages, unit: 'STAGES' %}
          </div>
          <div class="grow overflow--hidden">
            {% render 'stat_cell' with icon: road_glyph, value: dist_num, unit: 'KM' %}
          </div>
        </div>
      </div>
      {%- comment -%}
        
        
RIGHT: LAST YEAR JERSEY WINNERS title + jersey table

      
      {% endcomment %}
      <div class="col--span-6 gap--medium overflow--hidden">
        <div class="w--[1px] h--full bg--gray-50 no-shrink"></div>
        <div class="grow flex flex--col gap--small overflow--hidden">
          <span class="title title--small no-shrink">LAST YEAR JERSEY WINNERS</span>
          <table class="table table--small grow w--full">
            <colgroup>
              <col class="w--[34px]">
              <col class="w--[112px]">
              <col>
            </colgroup>
            <tbody>
              <tr>
                <td>
                  <img class="image w--[26px] h--[26px] no-shrink" src="data:image/svg+xml;base64,{{ jersey_gc | base64_encode }}">
                </td>
                <td>
                  <span class="label label--base label--gray 1bit:text--black">INDIVIDUAL</span>
                </td>
                <td>
                  <div class="flex flex--row flex--left flex--center-y gap--small overflow--hidden">
                    <div class="flex flex--center w--[42px] no-shrink">
                      {% render 'avatar' with url: yellow_photo, size: 32, fallback: person_glyph, alt: yellow_photo_alt %}
                    </div>
                    <div class="flex flex--col flex--left gap--none overflow--hidden">
                      <span class="title title--small">
                        {{ yellow_name | default: '—' }}
                      </span>
                      <span class="label label--xsmall label--gray 1bit:text--black">
                        {{ yellow_team_code }}
                      </span>
                    </div>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <img class="image w--[26px] h--[26px] no-shrink" src="data:image/svg+xml;base64,{{ jersey_pts | base64_encode }}">
                </td>
                <td>
                  <span class="label label--base label--gray 1bit:text--black">POINTS</span>
                </td>
                <td>
                  <div class="flex flex--row flex--left flex--center-y gap--small overflow--hidden">
                    <div class="flex flex--center w--[42px] no-shrink">
                      {% render 'avatar' with url: green_photo, size: 32, fallback: person_glyph, alt: green_photo_alt %}
                    </div>
                    <div class="flex flex--col flex--left gap--none overflow--hidden">
                      <span class="title title--small">
                        {{ green_name | default: '—' }}
                      </span>
                      <span class="label label--xsmall label--gray 1bit:text--black">
                        {{ green_team_code }}
                      </span>
                    </div>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <img class="image w--[26px] h--[26px] no-shrink" src="data:image/svg+xml;base64,{{ jersey_kom | base64_encode }}">
                </td>
                <td>
                  <span class="label label--base label--gray 1bit:text--black">CLIMBER</span>
                </td>
                <td>
                  <div class="flex flex--row flex--left flex--center-y gap--small overflow--hidden">
                    <div class="flex flex--center w--[42px] no-shrink">
                      {% render 'avatar' with url: kom_photo, size: 32, fallback: person_glyph, alt: kom_photo_alt %}
                    </div>
                    <div class="flex flex--col flex--left gap--none overflow--hidden">
                      <span class="title title--small">
                        {{ kom_name | default: '—' }}
                      </span>
                      <span class="label label--xsmall label--gray 1bit:text--black">
                        {{ kom_team_code }}
                      </span>
                    </div>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <img class="image w--[26px] h--[26px] no-shrink" src="data:image/svg+xml;base64,{{ jersey_yth | base64_encode }}">
                </td>
                <td>
                  <span class="label label--base label--gray 1bit:text--black">YOUNG</span>
                </td>
                <td>
                  <div class="flex flex--row flex--left flex--center-y gap--small overflow--hidden">
                    <div class="flex flex--center w--[42px] no-shrink">
                      {% render 'avatar' with url: white_photo, size: 32, fallback: person_glyph, alt: white_photo_alt %}
                    </div>
                    <div class="flex flex--col flex--left gap--none overflow--hidden">
                      <span class="title title--small">
                        {{ white_name | default: '—' }}
                      </span>
                      <span class="label label--xsmall label--gray 1bit:text--black">
                        {{ white_team_code }}
                      </span>
                    </div>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
          {%- comment -%}
            
            
X LANDSCAPE: first-stage info under the jersey holders (hidden on OG + X portrait) 

          
          {% endcomment %}
          <div class="hidden lg:flex lg:portrait:hidden flex--col flex--left gap--xsmall w--full no-shrink">
            <div class="divider mb--1 w--full"></div>
            <div class="flex flex--col w--full no-shrink">
              <span class="title title--small">STARTING OF WITH ...</span>
              <div class="grid grid--cols-12 gap--medium w--full h--[88px]">
                <div class="col--span-6 flex flex--col flex--left flex--center-y gap--xsmall overflow--hidden">
                  <div class="flex flex--row flex--left flex--center-y gap--small no-shrink">
                    {% render 'badge' with text: 'STAGE 1' %}
                    <span class="label label--xsmall label--gray">
                      {{ next_date | upcase }}
                    </span>
                  </div>
                  <span class="title title--small" data-clamp="2">
                    {{ next_start | upcase }}
                    
                    
› 

                    
                    {{ next_finish | upcase }}
                  </span>
                  <div class="flex flex--row flex--left flex--center-y gap--xsmall flex--wrap">
                    {%- if next_type and next_type != '' -%}
                      <span class="label label--xsmall label--outline">
                        {{ next_type | upcase }}
                      </span>
                    {% endif %}
                    {%- if next_km and next_km != '' -%}
                      <span class="label label--xsmall label--gray value--tnums">
                        {{ next_km }}
                      </span>
                    {% endif %}
                    {%- if next_gain and next_gain != 0 -%}
                      <span class="flex flex--row flex--center-y gap--xsmall">
                        <img class="image w--[12px] h--[10px] no-shrink" src="data:image/svg+xml;base64,{{ peak_glyph | base64_encode }}">
                        <span class="label label--xsmall label--gray value--tnums">
                          {{ next_gain }}
                          
                          
m

                        
                        </span>
                      </span>
                    {% endif %}
                  </div>
                </div>
                <div class="col--span-6 flex flex--center-y flex--center-x overflow--hidden">
                  {% render 'stage_profile' with path: profile_path, climbs: profile_climbs, fixedw: 205, h: 78, circ: 4.5, cfont: 4.2, km: next_km %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
