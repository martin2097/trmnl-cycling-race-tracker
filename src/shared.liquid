    <svg class="w--full" viewBox="0 0 280 27" font-size="1" xmlns="http://www.w3.org/2000/svg">
      <circle cx="10" cy="7" r="0.6" fill="#000"></circle>
      <circle cx="55" cy="5" r="0.5" fill="#000"></circle>
      <circle cx="38" cy="15" r="0.4" fill="#000"></circle>
      <circle cx="70" cy="9" r="0.5" fill="#000"></circle>
      {%- comment -%} crescent via mask (the bite shows the card through — no white-disc artifact) {%- endcomment -%}
      <mask id="moon_b"><circle cx="20" cy="12" r="8" fill="#fff"></circle><circle cx="23.5" cy="9" r="7" fill="#000"></circle></mask>
      <circle cx="20" cy="12" r="8" fill="#000" mask="url(#moon_b)"></circle>
      <text transform="translate(155,20) scale(8)" font-weight="bold" fill="#000" style="font-family:'NicoClean','Inter',system-ui,sans-serif">z</text>
      <text transform="translate(188,15) scale(11)" font-weight="bold" fill="#000" style="font-family:'NicoClean','Inter',system-ui,sans-serif">z</text>
      <text transform="translate(225,10) scale(15)" font-weight="bold" fill="#000" style="font-family:'NicoClean','Inter',system-ui,sans-serif">Z</text>
      <rect x="0" y="22" width="280" height="5" fill="#000"></rect>
    </svg>
  </div>
{% endtemplate %}
