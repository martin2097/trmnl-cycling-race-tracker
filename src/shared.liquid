{%- comment -%} no form fields — title comes from the race name produced by transform.py {%- endcomment -%}
{%- assign feed_title = race_title | default: trmnl.plugin_settings.instance_name | default: 'Tour de France' -%}
{%- assign race_year = race_title | split: ' ' | first -%}

{%- comment -%} title_bar — shared across all sizes; sibling of layout. params: title {%- endcomment -%}
{% template title_bar %}<div class="title_bar">
  <img class="image image-stroke" src="https://upload.wikimedia.org/wikipedia/commons/5/50/Tour_de_France_logo_%28black_background%29.svg">
  <span class="title">{{ title }}</span>
</div>{% endtemplate %}

{%- comment -%} badge — small black pill. params: text {%- endcomment -%}
{% template badge %}<span class="bg--black text--white rounded--small px--2 label label--xsmall lg:label--large no-shrink">{{ text }}</span>{% endtemplate %}

{%- comment -%} avatar — circular dithered photo, Tissot primary -> alt (Wikipedia) -> glyph via onerror.
  params: url, size, fallback (svg glyph), alt (optional 2nd-choice photo URL) {%- endcomment -%}
{% template avatar %}
  {% assign fb_src = alt %}
  {% if fb_src == nil or fb_src == '' %}{% capture fb_src %}data:image/svg+xml;base64,{{ fallback | base64_encode }}{% endcapture %}{% endif %}
  <div class="bg--white rounded--full no-shrink overflow--hidden flex flex--center w--[{{ size }}px] h--[{{ size }}px]">
    {% if url and url != '' %}<img class="image image-dither image--cover rounded--full w--full h--full" src="{{ url }}" onerror="this.onerror=null;this.src='{{ fb_src }}'">
    {% else %}<img class="image rounded--full w--[55%] h--[55%]" src="data:image/svg+xml;base64,{{ fallback | base64_encode }}">{% endif %}
  </div>
{% endtemplate %}


{%- comment -%} stat_cell — overview stat: pictogram + number + unit label (pre-race). params: icon, value, unit {%- endcomment -%}
{% template stat_cell %}
  <div class="flex flex--col flex--center-x flex--center-y gap--none h--full w--full overflow--hidden">
    <img class="lg:hidden image w--[22px] h--[22px] no-shrink mb--1" src="data:image/svg+xml;base64,{{ icon | base64_encode }}">
    <img class="hidden lg:visible image w--[30px] h--[30px] no-shrink mb--1" src="data:image/svg+xml;base64,{{ icon | base64_encode }}">
    <span class="value value--small lg:value--base lg:portrait:value--small value--tnums text--center">{{ value }}</span>
    <span class="label">{{ unit }}</span>
  </div>
{% endtemplate %}

{%- comment -%} jersey_card — vertical jersey holder (pre-race). Surname only on ONE
  line so long names (Evenepoel, Carapaz) can't wrap and collide. params: jersey, label, name, team, photo, alt, fallback {%- endcomment -%}
{% template jersey_card %}
  <div class="flex flex--col flex--center-x flex--center-y gap--xsmall h--full w--full overflow--hidden">
    <div class="flex flex--row flex--center-y gap--xsmall no-shrink">
      <img class="hidden lg:visible image w--[25px] h--[25px] no-shrink" src="data:image/svg+xml;base64,{{ jersey | base64_encode }}">
      <img class="lg:hidden image w--[15px] h--[15px] no-shrink" src="data:image/svg+xml;base64,{{ jersey | base64_encode }}">
      <span class="label lg:label--large label--gray 1bit:text--black">{{ label }}</span>
    </div>
    <div class="lg:hidden">
    {% render 'avatar' with url: photo, size: 40, fallback: fallback, alt: alt %}
    </div>
    <div class="hidden lg:visible">
    {% render 'avatar' with url: photo, size: 70, fallback: fallback, alt: alt %}
    </div>
    <div class="flex flex--col flex--center-x gap--none w--full no-shrink">
      <span class="title title--xsmall lg:title--large text--center">{{ name | default: '—' | split: ' ' | last }}</span>
      <span class="label label--xsmall lg:title--base label--gray 1bit:text--black">{{ team }}</span>
    </div>
  </div>
{% endtemplate %}

{%- comment -%} jersey_panel — horizontal jersey-holder card for the FULL bottom-left 2x2
  grid (TRMNL X only). Top: jersey icon + role label. Bottom: rider avatar + full name +
  team. params: jersey, label, name, team, photo, alt, fallback {%- endcomment -%}
{% template jersey_panel %}
  <div class="flex flex--col gap--large w--full h--full overflow--hidden">
    <div class="flex flex--row flex--center-y gap--xsmall no-shrink">
      <img class="image w--[35px] h--[35px] no-shrink" src="data:image/svg+xml;base64,{{ jersey | base64_encode }}">
      <span class="label label--xlarge label--gray">{{ label }}</span>
    </div>
    <div class="flex flex--row flex--left flex--center-y gap--small overflow--hidden">
      <div class="flex flex--center w--[70px] no-shrink">
        {% render 'avatar' with url: photo, size: 60, fallback: fallback, alt: alt %}
      </div>
      <div class="flex flex--col flex--left gap--none overflow--hidden">
        <span class="title title--large" data-clamp="2">{{ name | default: '—' }}</span>
        <span class="label label--large label--gray">{{ team }}</span>
      </div>
    </div>
  </div>
{% endtemplate %}
{% template jersey_panel_portrait %}
  {% assign awrap = av_wrap | default: 'w--[90px] mx--3' %}
  <div class="flex flex--col flex--center-y gap--large lg:portrait:gap w--full h--full overflow--hidden">
    
    <div class="flex flex--row flex--left flex--center-y gap--small w--full overflow--hidden">
      <div class="flex flex--center no-shrink {{ awrap }}">
        {% render 'avatar' with url: photo, size: 80, fallback: fallback, alt: alt %}
      </div>
      <div class="flex flex--col flex--left gap--none overflow--hidden">
        <div class="flex flex--row flex--center-y gap--xsmall no-shrink">
      <img class="image w--[25px] h--[25px] no-shrink" src="data:image/svg+xml;base64,{{ jersey | base64_encode }}">
      <span class="label label--xlarge lg:portrait:label--large label--gray">{{ label }}</span>
    </div>
        <span class="title title--large" data-clamp="2">{{ name | default: '—' }}</span>
        <span class="label label--large label--gray">{{ team }}</span>
      </div>
    </div>
  </div>
{% endtemplate %}


{%- comment -%} stage_profile — FIXED-metre silhouette + category climbs. The viewBox is
  split: the TOP third is reserved for the climb-category circles (so their numbers stay
  big + legible) and the BOTTOM two-thirds holds the elevation silhouette. Marker size
  scales with circ (circle radius) + cfont (number font), in viewBox units. fixedw renders
  an exact pixel width (h ≈ fixedw/2.63 keeps circles round); else fills container width.
  params: path, climbs, h, fixedw, circ, cfont {%- endcomment -%}
{% template stage_profile %}
  {% assign sw = fixedw | default: 0 %}
  {% assign cr = circ | default: 3.9 %}
  {% assign cf = cfont | default: 4.4 %}
  {% assign cy = 4.4 %}
  {% assign ly = cy | plus: cr | plus: 0.4 %}
  {% assign dyv = cf | times: 0.35 %}
  {%- comment -%} ink = silhouette + connector colour (#000 default). card = dithered rounded
    background, light gray everywhere by default. A solid ink strip runs along the bottom so flat
    stages read as a clean line; it carries the 0 km / total km markers in white. Climb + sprint
    circles stay white-fill / black-text so they read on the card. km = total stage distance. {%- endcomment -%}
  {% assign ink = ink | default: '#000' %}
  {% assign card = card | default: 'bg--gray-75' %}
  {% if card and card != '' %}<div class="{{ card }} rounded--large overflow--hidden pt--1{% if sw and sw != 0 %} flex flex--col flex--center-x{% else %} text--center{% endif %}">{% endif %}
  <svg viewBox="0 0 100 38" preserveAspectRatio="none" font-size="1"{% if sw and sw != 0 %} height="{{ h | default: 152 }}" width="{{ sw }}"{% else %} class="w--full"{% endif %}>
    {%- comment -%} silhouette baseline sits on the strip top (y=33) so the ink strip is fully UNDER
      the route, never overlapping its low parts; strip then runs edge-to-edge to the bottom. {%- endcomment -%}
    <g transform="translate(0,12.67) scale(1,0.535)">
      <polygon points="0,38 {{ path }} 100,38" fill="{{ ink }}"></polygon>
    </g>
    {%- comment -%} bottom ink strip + distance markers (0 km left, total km right, in white) {%- endcomment -%}
    <rect x="0" y="33" width="100" height="5" fill="{{ ink }}"></rect>
    <text transform="translate(3,36.7) scale(3)" fill="#fff" style="font-family:'NicoClean','Inter',system-ui,sans-serif">0 km</text>
    {% if km and km != '' %}<text transform="translate(97,36.7) scale(3)" fill="#fff" text-anchor="end" style="font-family:'NicoClean','Inter',system-ui,sans-serif">{{ km }}</text>{% endif %}
    {% for c in climbs %}
      {% assign cp = c | split: '|||' %}
      {%- comment -%} cdx = spread-out circle x (field 6); the elbow connector still points to the TRUE x (field 1).
        jy steps up per climb so neighbouring corners don't merge into one horizontal line {%- endcomment -%}
      {% assign cdx = cp[6] | default: cp[1] %}
      {% assign jstep = forloop.index0 | times: 1.0 %}
      {% assign jy = 12.6 | minus: jstep %}
      {% if jy < 9.0 %}{% assign jy = 9.0 %}{% endif %}
      <polyline points="{{ cdx }},{{ ly }} {{ cdx }},{{ jy }} {{ cp[1] }},{{ jy }} {{ cp[1] }},33" fill="none" stroke="{{ ink }}" stroke-width="0.3" stroke-dasharray="1,1"></polyline>
      <circle cx="{{ cdx }}" cy="{{ cy }}" r="{{ cr }}" fill="#fff" stroke="#000" stroke-width="0.5"></circle>
      <text transform="translate({{ cdx }},{{ cy }}) scale({{ cf }})" dy="0.35" font-weight="bold" text-anchor="middle" fill="#000" style="font-family:'NicoClean','Inter',system-ui,sans-serif">{{ cp[0] }}</text>
    {% endfor %}
  </svg>
  {% if card and card != '' %}</div>{% endif %}
{% endtemplate %}

{%- comment -%} rest_graphic — REST DAY stand-in for the stage profile, drawn in the SAME card style
  (light gray dithered card, edge-to-edge, black baseline strip). Crescent moon + Zzz on the gray,
  grounded on the strip. Same 100x38 viewBox / fixedw+h as stage_profile so it slots in identically. {%- endcomment -%}
{% template rest_graphic %}
  {% assign sw = fixedw | default: 0 %}
  <div class="bg--gray-75 rounded--large overflow--hidden pt--1{% if sw and sw != 0 %} flex flex--col flex--center-x{% else %} text--center{% endif %}">
    <svg viewBox="0 0 100 38" preserveAspectRatio="none" font-size="1"{% if sw and sw != 0 %} height="{{ h | default: 152 }}" width="{{ sw }}"{% else %} class="w--full"{% endif %}>
      <circle cx="9" cy="8" r="0.5" fill="#000"></circle>
      <circle cx="36" cy="6" r="0.5" fill="#000"></circle>
      <circle cx="15" cy="18" r="0.4" fill="#000"></circle>
      {%- comment -%} crescent via mask (the bite shows the card through — no white-disc artifact).
        id MUST be unique per render: rest_graphic appears twice in full (OG + X-landscape) and a
        shared id resolves to the hidden instance's mask, breaking the visible moon. {%- endcomment -%}
      <mask id="moon_g{{ sw }}"><circle cx="22" cy="13" r="6.5" fill="#fff"></circle><circle cx="25" cy="10.5" r="5.7" fill="#000"></circle></mask>
      <circle cx="22" cy="13" r="6.5" fill="#000" mask="url(#moon_g{{ sw }})"></circle>
      <text transform="translate(62,29) scale(8)" font-weight="bold" fill="#000" style="font-family:'NicoClean','Inter',system-ui,sans-serif">z</text>
      <text transform="translate(71,22) scale(11)" font-weight="bold" fill="#000" style="font-family:'NicoClean','Inter',system-ui,sans-serif">z</text>
      <text transform="translate(81,14) scale(15)" font-weight="bold" fill="#000" style="font-family:'NicoClean','Inter',system-ui,sans-serif">Z</text>
      <rect x="0" y="33" width="100" height="5" fill="#000"></rect>
    </svg>
  </div>
{% endtemplate %}

